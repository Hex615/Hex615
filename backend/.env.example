PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chatsplat

# Redis
REDIS_URL=redis://localhost:6379

# JWT — use long random strings, keep these secret
JWT_SECRET=change_me_min_32_chars_long_random_string
JWT_REFRESH_SECRET=change_me_different_min_32_chars_string

# Agora
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI — moderation is hardcoded ON in production
OPENAI_API_KEY=your_openai_key

# Firebase FCM push notifications
FCM_SERVICE_ACCOUNT_JSON={}

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8081

# Anthropic / Claude (optional)
# Set ANTHROPIC_API_KEY to enable /ai/claude endpoints. Keep this secret and do NOT commit it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: model name (e.g., claude-2)
ANTHROPIC_MODEL=claude-2
