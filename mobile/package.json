{
  "name": "chatsplat",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export --platform web --output-dir web-build",
    "electron": "npm run build:web && electron electron/main.js",
    "electron:run": "electron electron/main.js",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:dir": "npm run build:web && electron-builder --dir"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "6.6.1",
    "@react-navigation/native": "6.1.17",
    "@react-navigation/native-stack": "6.10.1",
    "agora-rtc-sdk-ng": "^4.20.0",
    "axios": "1.7.2",
    "expo": "~55.0.0",
    "expo-camera": "~55.0.18",
    "expo-file-system": "~55.0.20",
    "expo-image-picker": "~55.0.20",
    "expo-media-library": "~55.0.17",
    "expo-notifications": "~0.27.0",
    "expo-status-bar": "~55.0.6",
    "lottie-react-native": "~7.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.85.3",
    "react-native-agora": "^4.3.0",
    "react-native-deck-swiper": "2.0.17",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-gifted-chat": "2.4.0",
    "react-native-image-crop-picker": "0.41.3",
    "react-native-keyboard-controller": "1.13.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-vector-icons": "10.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "socket.io-client": "4.7.2",
    "zustand": "4.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.24.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.chatsplat.app",
    "productName": "Chatsplat",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "electron/**/*",
      "web-build/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Chatsplat needs your microphone for live audio rooms.",
        "NSCameraUsageDescription": "Chatsplat needs your camera for video rooms."
      }
    },
    "dmg": {
      "title": "Chatsplat ${version}"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-av"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-vector-icons"
        ]
      }
    }
  }
}
